# ============================================================
# KK-Agent environment configuration
# ============================================================
# Copy this file as .env and fill in your own Keys
#   cp .env.example .env
# The program will not print any Key in logs or interfaces
# ============================================================

# ---------- LLM configuration (any OpenAI-compatible provider works) ----------
# provider options: deepseek | openai | anthropic | glm | moonshot | qwen | compatible | mock
#   - deepseek / glm / moonshot / qwen are all OpenAI-compatible interfaces, just fill in base_url + key
#   - anthropic uses its native interface
#   - mock: no LLM is used; the Agent runs in rule-engine mode (can still fetch market data, compute indicators, and generate reports)
# << [SLOT] Fill in your LLM API Key here later >>
BIN_AGENT_LLM_PROVIDER=mock
BIN_AGENT_LLM_API_KEY=
BIN_AGENT_LLM_BASE_URL=
BIN_AGENT_LLM_MODEL=

# DeepSeek example (uncomment to use)
# BIN_AGENT_LLM_PROVIDER=deepseek
# BIN_AGENT_LLM_API_KEY=sk-xxxxxxxx
# BIN_AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
# BIN_AGENT_LLM_MODEL=deepseek-chat

# ---------- Binance API configuration ----------
# Public market data base URL (no Key required). Regions where api.binance.com is blocked can be switched to a reachable mirror
BIN_AGENT_BINANCE_API_BASE=https://api.binance.com
# Alternative (some networks reach data-v2 more easily)
# BIN_AGENT_BINANCE_API_BASE=https://data-api.binance.vision

# Spot trading signed API base URL; usually keep the same as above
BIN_AGENT_BINANCE_TRADE_BASE=https://api.binance.com

# ---------- Trading permissions (double safety switches) ----------
# Master switch: false => all trading endpoints refuse to execute (default false)
BIN_AGENT_TRADING_ENABLED=false
# Dry-run mode: true => order requests are only simulated and printed, not sent (default true)
BIN_AGENT_DRY_RUN=true
# Maximum notional (in USDT) allowed per order; requests exceeding it are intercepted
BIN_AGENT_MAX_ORDER_NOTIONAL=100
# Forbidden-currency blacklist (comma-separated), orders on these currencies are always rejected
BIN_AGENT_SYMBOL_BLACKLIST=
# Require manual confirmation of every real order in the CLI (yes/no); ineffective in Web mode (Web enforces dry-run)
BIN_AGENT_CONFIRM_TRADES=true

# ---------- MCP (Binance official remote MCP) ----------
# The only official endpoint; verify it character by character before connecting
BIN_AGENT_MCP_ENDPOINT=https://agent.binance.com/mcp/agentic
# Proxy for reaching agent.binance.com (required in some regions). Example:
# BIN_AGENT_MCP_PROXY=http://127.0.0.1:7890

# ---------- Web service ----------
BIN_AGENT_WEB_HOST=127.0.0.1
BIN_AGENT_WEB_PORT=8788

# ---------- Logs ----------
BIN_AGENT_LOG_LEVEL=INFO
